<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <ref name="FlowConfigContent"/>
  </start>

  <define name="FlowConfigContent">
    <element name="FlowConfig">
      <oneOrMore>
        <ref name="flowPageStructure"/>
      </oneOrMore>
    </element>
  </define>

  <define name="flowPageStructure">
    <oneOrMore>
      <choice>
        <element name="module">
          <attribute name="src">
            <data type="anyURI"/>
          </attribute>
        </element>

        <element name="page">
          <attribute name="title">
            <text/>
          </attribute>
          <attribute name="route">
            <data type="token"/>
          </attribute>
          <optional>
            <attribute name="exclude-from-stepper">
            </attribute>
          </optional>
          <optional>
            <attribute name="html-src">
            </attribute>
          </optional>
           <optional>
            <attribute name="group-by">
              <text/>
            </attribute>
          </optional>
          <zeroOrMore>
            <!-- A generated page is a run of screen divs, and a collection hub is that run followed
                 by the <fg-collection> holding the loop's screens. A choice between the two shapes
                 cannot express the mix, and an interleave cannot tell a screen div from the div in
                 HtmlBlockContent — so: any number of either, in any order. -->
            <element name="section">
              <zeroOrMore>
                <choice>
                  <ref name="df-screen-module"/>
                  <ref name="FlowConfigModuleContent"/>
                </choice>
              </zeroOrMore>
            </element>
          </zeroOrMore>
          <!-- Everything a page may carry after its sections, in any order: the modals its content
               links to, and page-level alerts — a knockout gate belongs to the page rather than to
               one of its sections, so it is authored as their sibling. -->
          <zeroOrMore>
           <choice>
            <ref name="fg-alert-module"/>
            <element name="modal-dialog">
              <attribute name="id">
                <text/>
              </attribute>
              <element name="modal-heading">
                <ref name="FlowConfigModuleInlineContent"/>
              </element>
              <element name="modal-content">
                <oneOrMore>
                  <choice>
                    <ref name="HtmlBlockContent"/>
                    <ref name="FlowConfigModuleInlineContent"/>
                  </choice>
                </oneOrMore>
              </element>
            </element>
           </choice>
          </zeroOrMore>
        </element>
      </choice>
    </oneOrMore>
  </define>

  <!-- One Direct File screen, carrying that screen's conditions as a synthesized gate fact.
       Direct File navigates a screen at a time and re-tests the next screen's conditions at each
       step; here the screens of one run sit on one page in declaration order and the runtime shows
       or hides each. `showOrHideAllElements` deletes the facts inside anything it hides, which is
       the same skip-and-clear the navigation gave. See codemod/README.md. -->
  <define name="df-screen-module">
    <element name="div">
      <attribute name="class">
        <text/>
      </attribute>
      <optional>
        <group>
          <attribute name="condition">
            <data type="anyURI"/>
          </attribute>
          <attribute name="operator">
            <choice>
              <value>isTrue</value>
              <value>isFalse</value>
            </choice>
          </attribute>
        </group>
      </optional>
      <ref name="FlowConfigModuleContent"/>
    </element>
  </define>

  <define name="fg-set-module">
    <element name="fg-set">
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
      <optional>
        <choice>
          <attribute name="if-false">
            <data type="anyURI"/>
          </attribute>
          <attribute name="if-true">
            <data type="anyURI"/>
          </attribute>
        </choice>
      </optional>
      <ref name="fg-set-content"/>
    </element>
  </define>

  <define name="ContentKey">
    <attribute name="content-key">
      <text/>
    </attribute>
  </define>

  <define name="fg-set-content">
    <optional>
      <attribute name="optional">
        <value>true</value>
      </attribute>
    </optional>
    <element name="question">
      <ref name="FlowConfigModuleInlineContent"/>
    </element>
    <!-- Both are optional and both are authored in either order, so neither may pin the other's
         position. Neither reaches the rendered page through this ordering anyway: the hint and the
         modal link are placed by nodes/fg-set.html. -->
    <interleave>
      <optional>
        <element name="hint">
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
      </optional>
      <optional>
        <ref name="modal-link-module"/>
      </optional>
    </interleave>
    <choice>
      <element name="input">
        <attribute name="type">
          <choice>
            <value>dollar</value>
            <value>text</value>
            <value>date</value>
            <value>int</value>
            <!-- Widened for this application: the seven types registered in Main.scala's
                 `inputTypes`. They take no child elements, exactly like the built-in scalars above,
                 because everything that varies is in the parser and the template rather than in the
                 flow. Listing them here is what makes `<input type="tinn">` a validation failure
                 instead of an "Unexpected input type" thrown halfway through the build. -->
            <value>tin</value>
            <value>ein</value>
            <value>pin</value>
            <value>ip-pin</value>
            <value>phone-number</value>
            <value>address</value>
            <value>bank-account</value>
          </choice>
        </attribute>
      </element>
      <element name="input">
        <attribute name="type">
          <value>boolean</value>
        </attribute>
        <zeroOrMore>
          <element name="option">
            <attribute name="value">
              <choice>
                <value>false</value>
                <value>true</value>
              </choice>
            </attribute>
            <ref name="FlowConfigModuleInlineContent"/>
          </element>
        </zeroOrMore>
      </element>
      <element name="input">
        <attribute name="type">
          <value>enum</value>
        </attribute>
        <attribute name="options-path">
          <data type="anyURI"/>
        </attribute>
        <oneOrMore>
          <element name="option">
            <attribute name="value">
              <data type="token"/>
            </attribute>
            <optional>
              <attribute name="description-key">
                <text/>
              </attribute>
            </optional>
            <text/>
          </element>
        </oneOrMore>
      </element>
      <element name="input">
        <attribute name="type">
          <value>multi-enum</value>
        </attribute>
        <attribute name="options-path">
          <data type="anyURI"/>
        </attribute>
        <oneOrMore>
          <element name="option">
            <attribute name="value">
              <data type="token"/>
            </attribute>
            <optional>
              <attribute name="description-key">
                <text/>
              </attribute>
            </optional>
            <text/>
          </element>
        </oneOrMore>
      </element>
      <element name="select">
        <attribute name="options-path">
          <data type="anyURI"/>
        </attribute>
        <oneOrMore>
          <element name="option">
            <attribute name="value">
              <data type="token"/>
            </attribute>
            <text/>
          </element>
        </oneOrMore>
      </element>
    </choice>
  </define>

  <define name="fg-collection-module">
    <element name="fg-collection">
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
      <optional>
        <attribute name="item-name">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="determiner">
          <text/>
        </attribute>
      </optional>
      <optional>
        <attribute name="disallow-empty">
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="add-item-if-true">
          <data type="anyURI"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="seed-item-if-true">
          <data type="anyURI"/>
        </attribute>
      </optional>
      <!-- A collection the taxpayer cannot change: no Add button, no per-item Remove. What a
           <Derived> collection needs, since its membership is decided by another fact. The eight
           auto-iterating loops are all of them. -->
      <optional>
        <attribute name="readonly">
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <choice>
          <attribute name="if-false">
            <data type="anyURI"/>
          </attribute>
          <attribute name="if-true">
            <data type="anyURI"/>
          </attribute>
        </choice>
      </optional>
      <!-- A choice rather than an interleave: a generated loop page carries screen divs, and a div
           is also one of the HtmlBlockContent shapes, which an interleave cannot tell apart. -->
      <zeroOrMore>
        <choice>
          <ref name="fg-set-module"></ref>
          <ref name="df-screen-module"/>
          <ref name="fg-section-gate-module"/>
          <!-- An alert scoped to one collection item — a knockout on the child being added, say. -->
          <ref name="fg-alert-module"/>
          <ref name="HtmlBlockContent"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="fg-section-gate-module">
    <element name="fg-section-gate">
      <group>
        <attribute name="condition">
          <data type="anyURI"/>
        </attribute>
        <attribute name="operator">
          <choice>
            <value>isTrue</value>
            <value>isFalse</value>
            <value>isZero</value>
            <value>isGreaterThanZero</value>
            <value>isIncomplete</value>
          </choice>
        </attribute>
        <attribute name="state">
          <choice>
            <value>pending</value>
            <value>complete</value>
          </choice>
        </attribute>
      </group>
      <element name="heading">
        <ref name="FlowConfigModuleInlineContent"/>
      </element>
      <element name="content">
        <ref name="FlowConfigModuleInlineContent"/>
      </element>
    </element>
  </define>

  <define name="details-module">
    <element name="details">
      <attribute name="open">
        <value>true</value>
      </attribute>
      <element name="summary">
        <choice>
          <element name="h1">
            <ref name="FlowConfigModuleInlineContent"/>
          </element>
          <element name="h2">
            <ref name="FlowConfigModuleInlineContent"/>
          </element>
          <ref name="FlowConfigModuleInlineContent"/>
        </choice>
      </element>
      <optional>
        <element name="div">
          <attribute name="class">
            <text/>
          </attribute>
          <ref name="HtmlBlockContent"/>
        </element>
      </optional>
      <zeroOrMore>
        <choice>
          <ref name="fg-set-module"/>
          <ref name="fg-collection-module"/>
          <ref name="fg-section-gate-module"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="fg-detail-module">
    <element name="fg-detail">
      <optional><attribute name="icon"><text/></attribute></optional>
      <optional><attribute name="heading-tag"><text/></attribute></optional>
      <optional><attribute name="open"><text/></attribute></optional>
      <optional><attribute name="class"><text/></attribute></optional>
      <!-- Single-question-per-screen page skipping; same pair as on fg-set. -->
      <optional><attribute name="if-true"><data type="anyURI"/></attribute></optional>
      <optional><attribute name="if-false"><data type="anyURI"/></attribute></optional>
      <optional><attribute name="condition"><data type="anyURI"/></attribute></optional>
      <optional><attribute name="operator"><choice><value>isTrue</value><value>isFalse</value></choice></attribute></optional>
      <element name="summary">
        <ref name="FlowConfigModuleInlineContent"/>
      </element>
      <zeroOrMore>
        <choice>
          <ref name="HtmlBlockContent"/>
          <ref name="fg-set-module"/>
          <ref name="fg-collection-module"/>
          <ref name="fg-section-gate-module"/>
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="fg-reset-module">
    <element name="fg-reset">
      <element name="button">
        <attribute name="class">
          <text/>
        </attribute>
        <attribute name="type">
          <value>reset</value>
        </attribute>
        <text/>
      </element>
    </element>
  </define>

  <!-- Declared for this application. form-builder parses <fg-apply> but its seed grammar never
       described it, because no application here had used one. Direct File's flow carries 73
       SetFactActions, which is what this element is.

       `value` writes a literal; `source` copies the current value of another fact. The parser
       requires exactly one, and this grammar says the same thing with a <choice>, so an
       fg-apply carrying both or neither fails validation before it reaches the build. -->
  <define name="fg-apply-module">
    <element name="fg-apply">
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
      <choice>
        <attribute name="value">
          <text/>
        </attribute>
        <attribute name="source">
          <data type="anyURI"/>
        </attribute>
      </choice>
      <empty/>
    </element>
  </define>

  <define name="fg-show-module">
    <element name="fg-show">
      <attribute name="path">
        <data type="anyURI"/>
      </attribute>
    </element>
  </define>

  <define name="FlowConfigUlElement">
    <element name="ul">
      <optional>
        <attribute name="class">
          <text/>
        </attribute>
      </optional>
      <optional>
        <group>
          <attribute name="condition">
            <data type="anyURI"/>
          </attribute>
          <attribute name="operator">
            <choice>
              <value>isTrue</value>
              <value>isFalse</value>
            </choice>
          </attribute>
        </group>
      </optional>
      <oneOrMore>
        <element name="li">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="fg-alert-module">
    <element name="fg-alert">
      <attribute name="alert-key">
        <text/>
      </attribute>
      <attribute name="alert-type">
        <choice>
          <value>error</value>
          <value>info</value>
          <value>warning</value>
          <value>success</value>
          <value>emergency</value>
        </choice>
      </attribute>
      <!-- Whether the alert blocks navigation. The schema used to permit this only as
           knockout="true" on an error alert; both flows write knockout="false" explicitly, and one
           knocks out on a warning, so the pairing is not a rule the authors follow. -->
      <optional>
        <attribute name="knockout">
          <choice>
            <value>true</value>
            <value>false</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="slim">
          <value>true</value>
        </attribute>
      </optional>
      <optional>
        <attribute name="icon">
          <value>false</value>
        </attribute>
      </optional>
      <optional>
        <choice>
          <attribute name="if-false">
            <data type="anyURI"/>
          </attribute>
          <attribute name="if-true">
            <data type="anyURI"/>
          </attribute>
        </choice>
      </optional>
      <optional>
        <attribute name="condition">
          <data type="anyURI"/>
        </attribute>
        <attribute name="operator">
          <choice>
            <value>isTrue</value>
            <value>isFalse</value>
          </choice>
        </attribute>
      </optional>
      <element name="heading">
        <ref name="FlowConfigModuleInlineContent"/>
      </element>
      <!-- Widened for this application: zeroOrMore rather than oneOrMore. Many of Direct File's
           alerts are a single sentence, authored as `alertText.heading` with no body at all — the
           heading *is* the message, and nodes/fg-alert.html renders it on its own perfectly well.
           Requiring a body would mean the transpiler inventing a paragraph that repeats it. -->
      <zeroOrMore>
        <ref name="AlertBodyContent"/>
      </zeroOrMore>
    </element>
  </define>

  <!-- What an alert may say: paragraphs and lists, optionally gathered into a
       <div class="usa-alert__text"> wrapper. Both shapes are authored today.

       Widened for this application with <fg-detail>: a Direct File alert may hold an accordion,
       which is what "You can file only as a paper tax return" plus a collapsed "Why?" is. Upstream
       expresses it as a DFAccordion nested in the alert's own children. -->
  <define name="AlertBodyContent">
    <choice>
      <ref name="fg-detail-module"/>
      <element name="p">
        <optional>
          <attribute name="class">
            <text/>
          </attribute>
        </optional>
        <!-- Widened for this application: an alert's paragraphs take a condition like any others.
             Direct File's alerts carry conditional lines inside them — one sentence for a single
             filer, another for a joint return — and the two are one alert, not two. -->
        <optional>
          <group>
            <attribute name="condition">
              <data type="anyURI"/>
            </attribute>
            <attribute name="operator">
              <choice>
                <value>isTrue</value>
                <value>isFalse</value>
              </choice>
            </attribute>
          </group>
        </optional>
        <ref name="FlowConfigModuleInlineContent"/>
      </element>
      <ref name="FlowConfigUlElement"/>
      <element name="div">
        <attribute name="class">
          <text/>
        </attribute>
        <oneOrMore>
          <choice>
            <element name="p">
              <optional>
                <attribute name="class">
                  <text/>
                </attribute>
              </optional>
              <ref name="FlowConfigModuleInlineContent"/>
            </element>
            <ref name="FlowConfigUlElement"/>
          </choice>
        </oneOrMore>
      </element>
    </choice>
  </define>
  <define name="modal-link-module">
    <element name="modal-link">
      <attribute name="for">
        <data type="anyURI"/>
      </attribute>
      <ref name="FlowConfigModuleInlineContent"/>
    </element>
  </define>

  <define name="HtmlBlockContent">
    <zeroOrMore>
      <choice>
        <element name="h1">
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
        <element name="h2">
          <optional>
            <group>
              <attribute name="condition">
                <data type="anyURI"/>
              </attribute>
              <attribute name="operator">
                <choice>
                  <value>isTrue</value>
                  <value>isFalse</value>
                  <value>isZero</value>
                  <value>isGreaterThanZero</value>
                  <value>isIncomplete</value>
                </choice>
              </attribute>
            </group>
          </optional>
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
        <element name="h3">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <optional>
            <group>
              <attribute name="condition">
                <data type="anyURI"/>
              </attribute>
              <attribute name="operator">
                <choice>
                  <value>isTrue</value>
                  <value>isFalse</value>
                  <value>isZero</value>
                  <value>isGreaterThanZero</value>
                  <value>isIncomplete</value>
                </choice>
              </attribute>
            </group>
          </optional>
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
        <element name="h4">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <optional>
            <group>
              <attribute name="condition">
                <data type="anyURI"/>
              </attribute>
              <attribute name="operator">
                <choice>
                  <value>isTrue</value>
                  <value>isFalse</value>
                  <value>isZero</value>
                  <value>isGreaterThanZero</value>
                  <value>isIncomplete</value>
                </choice>
              </attribute>
            </group>
          </optional>
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
        <element name="h5">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <optional>
            <group>
              <attribute name="condition">
                <data type="anyURI"/>
              </attribute>
              <attribute name="operator">
                <choice>
                  <value>isTrue</value>
                  <value>isFalse</value>
                  <value>isZero</value>
                  <value>isGreaterThanZero</value>
                  <value>isIncomplete</value>
                </choice>
              </attribute>
            </group>
          </optional>
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
        <element name="p">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <optional>
            <group>
              <attribute name="condition">
                <data type="anyURI"/>
              </attribute>
              <attribute name="operator">
                <choice>
                  <value>isTrue</value>
                  <value>isFalse</value>
                  <value>isZero</value>
                  <value>isGreaterThanZero</value>
                  <value>isIncomplete</value>
                </choice>
              </attribute>
            </group>
          </optional>
          <ref name="FlowConfigModuleInlineContent"/>
        </element>
        <!-- USWDS-style info alert: paragraphs, either directly or wrapped in a __body div.
             Both shapes are authored in the flow; neither nests further. -->
        <element name="div">
          <attribute name="class">
            <text/>
          </attribute>
          <optional>
            <group>
              <attribute name="condition">
                <data type="anyURI"/>
              </attribute>
              <attribute name="operator">
                <choice>
                  <value>isTrue</value>
                  <value>isFalse</value>
                </choice>
              </attribute>
            </group>
          </optional>
          <choice>
            <element name="div">
              <attribute name="class">
                <text/>
              </attribute>
              <ref name="AlertParagraphs"/>
            </element>
            <ref name="AlertParagraphs"/>
          </choice>
        </element>
        <element name="ol">
          <optional>
            <attribute name="class">
              <text/>
            </attribute>
          </optional>
          <!-- Widened for this application, to match the <ul> above. A conditional ordered list is
               the same construct as a conditional unordered one; only <ul> had the attributes, and
               the difference was an oversight rather than a rule. -->
          <optional>
            <group>
              <attribute name="condition">
                <data type="anyURI"/>
              </attribute>
              <attribute name="operator">
                <choice>
                  <value>isTrue</value>
                  <value>isFalse</value>
                </choice>
              </attribute>
            </group>
          </optional>
          <oneOrMore>
            <element name="li">
              <optional>
                <attribute name="class">
                  <text/>
                </attribute>
              </optional>
              <ref name="FlowConfigModuleInlineContent"/>
            </element>
          </oneOrMore>
        </element>
        <ref name="FlowConfigUlElement"/>
        <element name="table">
          <attribute name="class">
            <text/>
          </attribute>
          <ref name="TableContent"/>
        </element>
        <element name="button">
          <optional>
            <attribute name="id">
              <text/>
            </attribute>
          </optional>
          <optional>
            <attribute name="data-close-modal"/>
          </optional>
          <attribute name="onclick">
            <text/>
          </attribute>
          <attribute name="class">
            <text/>
          </attribute>
          <attribute name="type">
            <text/>
          </attribute>
          <ref name="FlowConfigModuleInlineContent"></ref>
        </element>
      </choice>
    </zeroOrMore>
  </define>

  <define name="FlowConfigModuleInlineContent">
    <mixed>
      <zeroOrMore>
        <choice>
          <element name="strong">
            <ref name="FlowConfigModuleInlineContent"/>
          </element>
          <!-- Widened for this application. Direct File's content uses <br/> 161 times, mostly to
               break an address or a list of names inside one paragraph. The scaffold needs no change
               to carry it: parser/Html.scala treats <p>, <li>, <td> and the headings as leaf nodes,
               storing their inner markup as a translation string and re-emitting it verbatim, so a
               <br/> inside one already survives the round trip. Only this grammar rejected it.
               Worth upstreaming into form-builder's seed FlowConfig.rng. -->
          <element name="br">
            <empty/>
          </element>
          <element name="span">
            <optional>
              <attribute name="class">
                <text/>
              </attribute>
            </optional>
            <optional>
              <group>
                <attribute name="condition">
                  <data type="anyURI"/>
                </attribute>
                <attribute name="operator">
                  <choice>
                    <value>isTrue</value>
                    <value>isFalse</value>
                  </choice>
                </attribute>
              </group>
            </optional>
            <ref name="FlowConfigModuleInlineContent"/>
          </element>
          <element name="a">
            <attribute name="href"/>
            <optional>
              <attribute name="class">
                <text/>
              </attribute>
            </optional>
            <optional>
              <attribute name="target">
                <value>_blank</value>
              </attribute>
            </optional>
            <ref name="FlowConfigModuleInlineContent"/>
          </element>
          <ref name="fg-show-module"/>
          <element name="a">
            <attribute name="href"></attribute>
            <text/>
          </element>
          <ref name="modal-link-module"/>
        </choice>
      </zeroOrMore>
    </mixed>
  </define>

  <define name="TableContent">
    <optional>
      <element name="caption">
        <ref name="FlowConfigModuleInlineContent"/>
      </element>
    </optional>
    <choice>
      <!-- Table with explicit sections -->
      <group>
        <optional>
          <element name="thead">
            <ref name="TableRowGroup"/>
          </element>
        </optional>
        <optional>
          <element name="tfoot">
            <ref name="TableRowGroup"/>
          </element>
        </optional>
        <zeroOrMore>
          <element name="tbody">
            <ref name="TableRowGroup"/>
          </element>
        </zeroOrMore>
      </group>
      <!-- Table with direct rows (implicit tbody) -->
      <oneOrMore>
        <element name="tr">
          <ref name="TableRow"/>
        </element>
      </oneOrMore>
    </choice>
  </define>

  <define name="TableRowGroup">
    <oneOrMore>
      <element name="tr">
        <ref name="TableRow"/>
      </element>
    </oneOrMore>
  </define>

  <define name="TableRow">
    <oneOrMore>
      <choice>
        <element name="th">
          <optional>
            <attribute name="scope">
              <choice>
                <value>row</value>
                <value>col</value>
              </choice>
            </attribute>
          </optional>
          <ref name="TableCellContent"/>
        </element>
        <element name="td">
          <optional>
            <attribute name="scope">
              <choice>
                <value>row</value>
                <value>col</value>
              </choice>
            </attribute>
          </optional>
          <ref name="TableCellContent"/>
        </element>
      </choice>
    </oneOrMore>
  </define>

  <define name="TableCellContent">
    <ref name="FlowConfigModuleInlineContent"/>
  </define>

  <define name="AlertParagraphs">
    <oneOrMore>
      <element name="p">
        <optional>
          <attribute name="class">
            <text/>
          </attribute>
        </optional>
        <ref name="FlowConfigModuleInlineContent"/>
      </element>
    </oneOrMore>
  </define>

  <define name="FlowConfigModuleContent">
    <mixed>
      <zeroOrMore>
        <choice>
          <!--
            These FlowConfigModule XML elements are directly translated to their HTML equivalents by the flow code.
            If we add more of the same in the future, those elements would go here.
            These rules essentially say these can appear in any order and can be nested within each other.
           -->
          <ref name="HtmlBlockContent"/>
          <ref name="fg-set-module"/>
          <ref name="fg-alert-module"/>
          <ref name="fg-collection-module"/>
          <ref name="fg-reset-module"/>
          <ref name="fg-apply-module"/>
          <ref name="fg-section-gate-module"/>
          <ref name="details-module"/>
          <ref name="fg-detail-module"/>
        </choice>
      </zeroOrMore>
    </mixed>
  </define>

</grammar>
