<?xml version="1.0"?>
<?xml-model href="./FlowConfig.rng"?>
<FlowConfig>
  <!-- Replaces 01-basic-info/: who-is-applying, applicant-contact, home-address,
       notification-prefs, confirm-text and shortcut.

       Two of those pages carried no question at all. confirm-text.html displayed a confirmation
       message and moved on; shortcut.html existed only to offer an early submit link to SNAP-only
       applicants. Neither survives as a page.

       Name, date of birth and SSN are not here — they are per-person, and the person filling in
       the form is a row in the household collection like everyone else. -->
  <page title="About you" route="/about-you">
    <section>
      <h2>About you</h2>

      <fg-set path="/applyingFor">
        <question>Who are you applying for?</question>
        <input type="enum" options-path="/applyingForOptions">
          <option value="myself">Myself</option>
          <option value="meAndSomeoneElse">Me and someone else</option>
          <option value="oneOrMorePeople">On behalf of one or more other people</option>
        </input>
      </fg-set>

      <h3>Where can we send you mail?</h3>

      <fg-set path="/mailingAddressStreet">
        <question>Street address</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/mailingAddressStreetLine2">
        <question>Apartment, suite or unit</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/mailingAddressCity">
        <question>City</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/mailingAddressState">
        <question>State</question>
        <select options-path="/stateOptions">
          <option value="AL">Alabama</option>
          <option value="AK">Alaska</option>
          <option value="AZ">Arizona</option>
          <option value="AR">Arkansas</option>
          <option value="CA">California</option>
          <option value="CO">Colorado</option>
          <option value="CT">Connecticut</option>
          <option value="DE">Delaware</option>
          <option value="DC">District of Columbia</option>
          <option value="FL">Florida</option>
          <option value="GA">Georgia</option>
          <option value="HI">Hawaii</option>
          <option value="ID">Idaho</option>
          <option value="IL">Illinois</option>
          <option value="IN">Indiana</option>
          <option value="IA">Iowa</option>
          <option value="KS">Kansas</option>
          <option value="KY">Kentucky</option>
          <option value="LA">Louisiana</option>
          <option value="ME">Maine</option>
          <option value="MD">Maryland</option>
          <option value="MA">Massachusetts</option>
          <option value="MI">Michigan</option>
          <option value="MN">Minnesota</option>
          <option value="MS">Mississippi</option>
          <option value="MO">Missouri</option>
          <option value="MT">Montana</option>
          <option value="NE">Nebraska</option>
          <option value="NV">Nevada</option>
          <option value="NH">New Hampshire</option>
          <option value="NJ">New Jersey</option>
          <option value="NM">New Mexico</option>
          <option value="NY">New York</option>
          <option value="NC">North Carolina</option>
          <option value="ND">North Dakota</option>
          <option value="OH">Ohio</option>
          <option value="OK">Oklahoma</option>
          <option value="OR">Oregon</option>
          <option value="PA">Pennsylvania</option>
          <option value="RI">Rhode Island</option>
          <option value="SC">South Carolina</option>
          <option value="SD">South Dakota</option>
          <option value="TN">Tennessee</option>
          <option value="TX">Texas</option>
          <option value="UT">Utah</option>
          <option value="VT">Vermont</option>
          <option value="VA">Virginia</option>
          <option value="WA">Washington</option>
          <option value="WV">West Virginia</option>
          <option value="WI">Wisconsin</option>
          <option value="WY">Wyoming</option>
        </select>
      </fg-set>

      <fg-set path="/mailingAddressZip">
        <question>ZIP code</question>
        <input type="text"/>
      </fg-set>

      <!-- The one clean skip-if in the prototype: the answer is its own gate, so no flow fact. -->
      <fg-set path="/isMailAndHomeTheSame">
        <question>Is this also where you live?</question>
        <input type="boolean">
          <option value="true">Yes</option>
          <option value="false">No</option>
        </input>
      </fg-set>

      <h3>Where do you live?</h3>

      <fg-set path="/homeAddressStreet" if-false="/isMailAndHomeTheSame">
        <question>Home street address</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/homeAddressStreetLine2" if-false="/isMailAndHomeTheSame">
        <question>Home apartment, suite or unit</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/homeAddressCity" if-false="/isMailAndHomeTheSame">
        <question>Home city</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/homeAddressState" if-false="/isMailAndHomeTheSame">
        <question>Home state</question>
        <select options-path="/stateOptions">
          <option value="AL">Alabama</option>
          <option value="AK">Alaska</option>
          <option value="AZ">Arizona</option>
          <option value="AR">Arkansas</option>
          <option value="CA">California</option>
          <option value="CO">Colorado</option>
          <option value="CT">Connecticut</option>
          <option value="DE">Delaware</option>
          <option value="DC">District of Columbia</option>
          <option value="FL">Florida</option>
          <option value="GA">Georgia</option>
          <option value="HI">Hawaii</option>
          <option value="ID">Idaho</option>
          <option value="IL">Illinois</option>
          <option value="IN">Indiana</option>
          <option value="IA">Iowa</option>
          <option value="KS">Kansas</option>
          <option value="KY">Kentucky</option>
          <option value="LA">Louisiana</option>
          <option value="ME">Maine</option>
          <option value="MD">Maryland</option>
          <option value="MA">Massachusetts</option>
          <option value="MI">Michigan</option>
          <option value="MN">Minnesota</option>
          <option value="MS">Mississippi</option>
          <option value="MO">Missouri</option>
          <option value="MT">Montana</option>
          <option value="NE">Nebraska</option>
          <option value="NV">Nevada</option>
          <option value="NH">New Hampshire</option>
          <option value="NJ">New Jersey</option>
          <option value="NM">New Mexico</option>
          <option value="NY">New York</option>
          <option value="NC">North Carolina</option>
          <option value="ND">North Dakota</option>
          <option value="OH">Ohio</option>
          <option value="OK">Oklahoma</option>
          <option value="OR">Oregon</option>
          <option value="PA">Pennsylvania</option>
          <option value="RI">Rhode Island</option>
          <option value="SC">South Carolina</option>
          <option value="SD">South Dakota</option>
          <option value="TN">Tennessee</option>
          <option value="TX">Texas</option>
          <option value="UT">Utah</option>
          <option value="VT">Vermont</option>
          <option value="VA">Virginia</option>
          <option value="WA">Washington</option>
          <option value="WV">West Virginia</option>
          <option value="WI">Wisconsin</option>
          <option value="WY">Wyoming</option>
        </select>
      </fg-set>

      <fg-set path="/homeAddressZip" if-false="/isMailAndHomeTheSame">
        <question>Home ZIP code</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/housingIsNotStable" if-false="/isMailAndHomeTheSame">
        <question>Is your housing situation unstable or temporary?</question>
        <hint>Telling us does not affect your application. It helps the office reach you.</hint>
        <input type="boolean">
          <option value="true">Yes</option>
          <option value="false">No</option>
        </input>
      </fg-set>

      <h3>How should we keep in touch?</h3>

      <fg-set path="/notificationPreferences">
        <question>How would you like us to contact you?</question>
        <input type="multi-enum" options-path="/notificationPreferenceOptions">
          <option value="text">Text message</option>
          <option value="call">Phone call</option>
          <option value="email">Email</option>
          <option value="mail">Postal mail</option>
        </input>
      </fg-set>

      <fg-set path="/contactPhone">
        <question>What is your phone number?</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/contactEmail">
        <question>What is your email address?</question>
        <input type="text"/>
      </fg-set>

      <fg-set path="/smsPhone" if-true="/flowShouldAskSmsPhone">
        <question>Which number should we text?</question>
        <hint>We will send a confirmation message to this number.</hint>
        <input type="text"/>
      </fg-set>

      <fg-set path="/notificationTimes">
        <question>When is it easiest to reach you?</question>
        <input type="multi-enum" options-path="/notificationTimeOptions">
          <option value="morning">Morning</option>
          <option value="afternoon">Afternoon</option>
          <option value="evening">Evening</option>
        </input>
      </fg-set>
    </section>
  </page>
</FlowConfig>
