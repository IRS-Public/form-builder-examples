<?xml version="1.0"?>
<?xml-model href="./FlowConfig.rng"?>
<FlowConfig>
  <!-- The whole of the prototype's per-person interview, expressed once.

       Absorbs 01-basic-info/{applicant-name,applicant-dob-sex,ssn}, all of 02-your-details/,
       03-basic-family/household-names, all 24 pages of 03-family-details/, all 6 of
       03-family-member-address/, the per-person and job pages of 04-finances/, and all of
       05-citizenship/ — roughly 78 of the prototype's 121 pages.

       The collection sits on its own page. Route slugs are minted from the last segment of a fact
       path, so mixing a collection with unrelated questions on one page invites slug collisions
       when the flow is split one-question-per-screen. -->
  <page title="Your household" route="/household">
    <section>
      <h2>Your household</h2>
      <p>
        Add everyone who lives with you or who you file taxes with, including yourself. We ask
        about everyone, even people you are not applying for, because it affects what you qualify
        for.
      </p>

      <fg-alert alert-type="error" alert-key="two-people-marked-as-self" knockout="true"
                condition="/flowMoreThanOnePersonMarkedAsSelf" operator="isTrue">
        <heading>Only one person can be you</heading>
        <p class="usa-alert__text">
          More than one person is marked as the person filling in this application. Edit the list so
          that only one is.
        </p>
      </fg-alert>

      <fg-alert alert-type="warning" alert-key="nobody-marked-as-self" knockout="false"
                condition="/flowNobodyMarkedAsSelf" operator="isTrue">
        <heading>Are you in this list?</heading>
        <p class="usa-alert__text">
          Nobody here is marked as the person filling in the application. If you are applying for
          yourself, add yourself to the list.
        </p>
      </fg-alert>

      <fg-collection path="/householdMembers" item-name="person" determiner="another">
        <fg-set path="/householdMembers/*/firstName">
          <question>First name</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/middleName">
          <question>Middle name</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/lastName">
          <question>Last name</question>
          <input type="text"/>
        </fg-set>

        <!-- Not an assumed first row. The prototype's own "On behalf of one or more people" option
             means the person filling in the form may not be on the application at all. -->
        <fg-set path="/householdMembers/*/isSelf">
          <question>Is this you, the person filling in this application?</question>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/relationship" if-true="/householdMembers/*/flowIsNotSelf">
          <question>How is this person related to you?</question>
          <select options-path="/relationshipOptions">
            <option value="spouse">Spouse</option>
            <option value="child">Child</option>
            <option value="stepChild">Stepchild</option>
            <option value="fosterChild">Foster child</option>
            <option value="parent">Parent</option>
            <option value="sibling">Brother or sister</option>
            <option value="grandparent">Grandparent</option>
            <option value="grandchild">Grandchild</option>
            <option value="otherRelative">Other relative</option>
            <option value="unrelated">Not related</option>
            <option value="other">Other</option>
          </select>
        </fg-set>

        <fg-set path="/householdMembers/*/relationshipOther"
                if-true="/householdMembers/*/flowShouldAskRelationshipOther">
          <question>How are they related to you?</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/isApplicant">
          <question>Are you applying for benefits for this person?</question>
          <hint>Say no if they live with you but are not applying.</hint>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/inTaxHousehold">
          <question>Do you file federal taxes together with this person?</question>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/dateOfBirth">
          <question>Date of birth</question>
          <input type="date"/>
        </fg-set>

        <fg-set path="/householdMembers/*/sex">
          <question>Sex</question>
          <input type="enum" options-path="/sexOptions">
            <option value="female">Female</option>
            <option value="male">Male</option>
          </input>
        </fg-set>

        <!-- Prototype: the .applicant-only block. Someone who is only household context was never
             asked for a Social Security number. -->
        <fg-set path="/householdMembers/*/ssn" if-true="/householdMembers/*/flowShouldAskSsn">
          <question>Social Security number</question>
          <hint>We need this only for people who are applying for benefits.</hint>
          <input type="text"/>
        </fg-set>

        <!-- Prototype: eight checkboxes, duplicated once for the applicant and once per person,
             with an abridged single-radio variant for non-applicant males writing the same key. -->
        <fg-set path="/householdMembers/*/commonCases">
          <question>Do any of these apply to this person?</question>
          <hint>Select all that apply. Select none if they do not.</hint>
          <input type="multi-enum" options-path="/commonCaseOptions">
            <option value="pregnant">Is pregnant</option>
            <option value="hadBaby">Recently had a baby</option>
            <option value="student">Is a student</option>
            <option value="foster">Is in foster care, or was</option>
            <option value="disability">Has a disability</option>
            <option value="insurance">Has health insurance</option>
            <option value="cashAssistance">Gets cash assistance</option>
            <option value="medicalBills">Has medical bills from the last three months</option>
          </input>
        </fg-set>

        <!-- Pregnancy and insurance were competing destinations in the prototype, resolved by a
             cascading override where the last true test won. Two independent gates replace it. -->
        <fg-set path="/householdMembers/*/dueDate"
                if-true="/householdMembers/*/flowShouldAskPregnancyDetail">
          <question>When is the baby due?</question>
          <input type="date"/>
        </fg-set>

        <fg-set path="/householdMembers/*/babiesExpected"
                if-true="/householdMembers/*/flowShouldAskPregnancyDetail">
          <question>How many babies are expected?</question>
          <input type="int"/>
        </fg-set>

        <fg-set path="/householdMembers/*/insuranceTypes"
                if-true="/householdMembers/*/flowShouldAskInsuranceDetail">
          <question>What kind of health insurance does this person have?</question>
          <input type="multi-enum" options-path="/insuranceTypeOptions">
            <option value="medicare">Medicare</option>
            <option value="medicaid">Medicaid</option>
            <option value="otherPublic">Another public program</option>
            <option value="va">Veterans Affairs</option>
            <option value="employer">Through an employer</option>
            <option value="private">Bought on their own</option>
            <option value="peaceCorps">Peace Corps</option>
            <option value="limited">Limited coverage only</option>
            <option value="unknown">Not sure</option>
          </input>
        </fg-set>

        <!-- Prototype: a checkbox whose handler copied the applicant's address into this person's
             inputs. Nothing is copied here; the questions are simply not asked. -->
        <fg-set path="/householdMembers/*/livesAtMailingAddress">
          <question>Does this person live at your mailing address?</question>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/addressStreet"
                if-true="/householdMembers/*/flowShouldAskOwnAddress">
          <question>Their street address</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/addressStreetLine2"
                if-true="/householdMembers/*/flowShouldAskOwnAddress">
          <question>Their apartment, suite or unit</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/addressCity"
                if-true="/householdMembers/*/flowShouldAskOwnAddress">
          <question>Their city</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/addressState"
                if-true="/householdMembers/*/flowShouldAskOwnAddress">
          <question>Their state</question>
          <select options-path="/stateOptions">
              <option value="AL">Alabama</option>
              <option value="AK">Alaska</option>
              <option value="AZ">Arizona</option>
              <option value="AR">Arkansas</option>
              <option value="CA">California</option>
              <option value="CO">Colorado</option>
              <option value="CT">Connecticut</option>
              <option value="DE">Delaware</option>
              <option value="DC">District of Columbia</option>
              <option value="FL">Florida</option>
              <option value="GA">Georgia</option>
              <option value="HI">Hawaii</option>
              <option value="ID">Idaho</option>
              <option value="IL">Illinois</option>
              <option value="IN">Indiana</option>
              <option value="IA">Iowa</option>
              <option value="KS">Kansas</option>
              <option value="KY">Kentucky</option>
              <option value="LA">Louisiana</option>
              <option value="ME">Maine</option>
              <option value="MD">Maryland</option>
              <option value="MA">Massachusetts</option>
              <option value="MI">Michigan</option>
              <option value="MN">Minnesota</option>
              <option value="MS">Mississippi</option>
              <option value="MO">Missouri</option>
              <option value="MT">Montana</option>
              <option value="NE">Nebraska</option>
              <option value="NV">Nevada</option>
              <option value="NH">New Hampshire</option>
              <option value="NJ">New Jersey</option>
              <option value="NM">New Mexico</option>
              <option value="NY">New York</option>
              <option value="NC">North Carolina</option>
              <option value="ND">North Dakota</option>
              <option value="OH">Ohio</option>
              <option value="OK">Oklahoma</option>
              <option value="OR">Oregon</option>
              <option value="PA">Pennsylvania</option>
              <option value="RI">Rhode Island</option>
              <option value="SC">South Carolina</option>
              <option value="SD">South Dakota</option>
              <option value="TN">Tennessee</option>
              <option value="TX">Texas</option>
              <option value="UT">Utah</option>
              <option value="VT">Vermont</option>
              <option value="VA">Virginia</option>
              <option value="WA">Washington</option>
              <option value="WV">West Virginia</option>
              <option value="WI">Wisconsin</option>
              <option value="WY">Wyoming</option>
          </select>
        </fg-set>

        <fg-set path="/householdMembers/*/addressZip"
                if-true="/householdMembers/*/flowShouldAskOwnAddress">
          <question>Their ZIP code</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/incomeTypes">
          <question>Where does this person's money come from?</question>
          <hint>Select all that apply. Select none if they have no income.</hint>
          <input type="multi-enum" options-path="/incomeTypeOptions">
            <option value="job">A job</option>
            <option value="selfEmployment">Self-employment</option>
            <option value="unemployment">Unemployment</option>
            <option value="disability">Disability</option>
            <option value="socialSecurity">Social Security</option>
            <option value="retirement">Retirement</option>
            <option value="pension">A pension</option>
            <option value="alimony">Alimony</option>
            <option value="other">Something else</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/otherIncomeAmount">
          <question>How much do they receive from everything other than a job, each month?</question>
          <input type="dollar"/>
        </fg-set>

        <!-- Three job slots, the prototype's own hard cap, asked in place of its 18 separate
             job-details pages. -->
        <fg-set path="/householdMembers/*/job1EmployerName"
                if-true="/householdMembers/*/flowShouldAskJobDetails">
          <question>Who is their employer?</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/job1PayFrequency"
                if-true="/householdMembers/*/flowShouldAskJobDetails">
          <question>How often are they paid?</question>
          <input type="enum" options-path="/payFrequencyOptions">
            <option value="weekly">Every week</option>
            <option value="everyTwoWeeks">Every two weeks</option>
            <option value="twiceAMonth">Twice a month</option>
            <option value="monthly">Once a month</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/job1Wages"
                if-true="/householdMembers/*/flowShouldAskJobDetails">
          <question>How much do they earn before deductions, each pay period?</question>
          <input type="dollar"/>
        </fg-set>

        <fg-set path="/householdMembers/*/job1HoursPerPayPeriod"
                if-true="/householdMembers/*/flowShouldAskJobDetails">
          <question>How many hours do they work each pay period?</question>
          <input type="int"/>
        </fg-set>

        <fg-set path="/householdMembers/*/hasSecondJob"
                if-true="/householdMembers/*/flowShouldAskJobDetails">
          <question>Do they have a second job?</question>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/job2EmployerName"
                if-true="/householdMembers/*/flowShouldAskSecondJob">
          <question>Who is their second employer?</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/job2PayFrequency"
                if-true="/householdMembers/*/flowShouldAskSecondJob">
          <question>How often does the second job pay?</question>
          <input type="enum" options-path="/payFrequencyOptions">
            <option value="weekly">Every week</option>
            <option value="everyTwoWeeks">Every two weeks</option>
            <option value="twiceAMonth">Twice a month</option>
            <option value="monthly">Once a month</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/job2Wages"
                if-true="/householdMembers/*/flowShouldAskSecondJob">
          <question>How much does the second job pay each pay period?</question>
          <input type="dollar"/>
        </fg-set>

        <fg-set path="/householdMembers/*/job2HoursPerPayPeriod"
                if-true="/householdMembers/*/flowShouldAskSecondJob">
          <question>How many hours is the second job each pay period?</question>
          <input type="int"/>
        </fg-set>

        <fg-set path="/householdMembers/*/hasThirdJob"
                if-true="/householdMembers/*/flowShouldAskSecondJob">
          <question>Do they have a third job?</question>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/job3EmployerName"
                if-true="/householdMembers/*/flowShouldAskThirdJob">
          <question>Who is their third employer?</question>
          <input type="text"/>
        </fg-set>

        <fg-set path="/householdMembers/*/job3PayFrequency"
                if-true="/householdMembers/*/flowShouldAskThirdJob">
          <question>How often does the third job pay?</question>
          <input type="enum" options-path="/payFrequencyOptions">
            <option value="weekly">Every week</option>
            <option value="everyTwoWeeks">Every two weeks</option>
            <option value="twiceAMonth">Twice a month</option>
            <option value="monthly">Once a month</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/job3Wages"
                if-true="/householdMembers/*/flowShouldAskThirdJob">
          <question>How much does the third job pay each pay period?</question>
          <input type="dollar"/>
        </fg-set>

        <fg-set path="/householdMembers/*/job3HoursPerPayPeriod"
                if-true="/householdMembers/*/flowShouldAskThirdJob">
          <question>How many hours is the third job each pay period?</question>
          <input type="int"/>
        </fg-set>

        <!-- Prototype: determine-who.html plus six follow-up pages, each re-implementing an
             ascending else-if chain so every flagged non-citizen was visited exactly once. -->
        <fg-set path="/householdMembers/*/isCitizen">
          <question>Is this person a U.S. citizen or U.S. national?</question>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/hasEligibleImmigrationStatus"
                if-true="/householdMembers/*/flowNeedsCitizenshipFollowUp">
          <question>Does this person have an eligible immigration status?</question>
          <input type="boolean">
            <option value="true">Yes</option>
            <option value="false">No</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/immigrationDocument"
                if-true="/householdMembers/*/flowNeedsImmigrationDocument">
          <question>Which document can they provide?</question>
          <input type="enum" options-path="/immigrationDocumentOptions">
            <option value="alienNumber">Alien number</option>
            <option value="sevisId">SEVIS ID</option>
            <option value="cardOrPassport">Card or passport number</option>
            <option value="other">Another document</option>
          </input>
        </fg-set>

        <fg-set path="/householdMembers/*/otherImmigrationDocumentType"
                if-true="/householdMembers/*/flowNeedsOtherDocumentType">
          <question>What kind of document is it?</question>
          <input type="text"/>
        </fg-set>

        <!-- Per person by construction. Every personN-document.html in the prototype wrote the
             same un-namespaced key, so each person overwrote the one before. -->
        <fg-set path="/householdMembers/*/immigrationDocumentNumber"
                if-true="/householdMembers/*/flowNeedsImmigrationDocument">
          <question>What is the document number?</question>
          <input type="text"/>
        </fg-set>
      </fg-collection>
    </section>
  </page>
</FlowConfig>
