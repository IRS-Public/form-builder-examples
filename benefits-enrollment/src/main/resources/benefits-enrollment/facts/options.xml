<?xml version="1.0"?>
<?xml-model href="./FactDictionaryModule.rng"?>
<FactDictionaryModule>
  <Facts>
    <!-- Every enum's option set is itself a fact. The prototype hard-coded these as <option>
         elements repeated across up to seven near-identical pages; here each list exists once and
         the flow points at it by path. -->

    <Fact path="/benefitOptions">
      <Description>The programs this application covers. The prototype asked for these as two
        independent checkboxes whose value= attributes were dead markup — storeData() wrote the
        literal strings "yes"/"no" keyed by element id.</Description>
      <Derived>
        <EnumOptions>
          <String>foodAssistance</String>
          <String>healthcare</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/applyingForOptions">
      <Description>Prototype: the applyingFor radio on who-is-applying.html. Its
        "for-someone-else" branch was dead code — no option carried that value — so only the three
        real choices survive.</Description>
      <Derived>
        <EnumOptions>
          <String>myself</String>
          <String>meAndSomeoneElse</String>
          <String>oneOrMorePeople</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/sexOptions">
      <Derived>
        <EnumOptions>
          <String>female</String>
          <String>male</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/relationshipOptions">
      <Description>Prototype: the householdMemberNRelationship select, with its "Other" option
        opening a free-text field.</Description>
      <Derived>
        <EnumOptions>
          <String>spouse</String>
          <String>child</String>
          <String>stepChild</String>
          <String>fosterChild</String>
          <String>parent</String>
          <String>sibling</String>
          <String>grandparent</String>
          <String>grandchild</String>
          <String>otherRelative</String>
          <String>unrelated</String>
          <String>other</String>
        </EnumOptions>
      </Derived>
    </Fact>

